{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "glb-extractor",
    "version": "1.0.0",
    "author": "Cocos Creator",
    "editor": ">=3.8.8",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "npx tsc"
    },
    "description": "i18n:glb-extractor.description",
    "main": "./dist/main.js",
    "dependencies": {
        "fs-extra": "^10.0.0"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.8",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "typescript": "^5.8.2"
    },
    "panels": {
        "default": {
            "title": "GLB Extractor",
            "type": "dockable",
            "main": "dist/panels/default",
            "size": {
                "min-width": 480,
                "min-height": 360,
                "width": 900,
                "height": 600
            }
        }
    },
    "scene": {
        "script": "./dist/contributions/scene.js"
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:menu.panel/glb-extractor",
                "label": "i18n:glb-extractor.open_panel",
                "message": "open-panel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            }
        }
    }
}
